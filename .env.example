# Copiar este archivo como ".env" (o exportar estas mismas variables en la terminal)
# y completar los valores reales. Nunca subir el .env real a un repositorio.
# Los valores que lleven espacios u otros símbolos (como COMPANY_HOURS o DEFAULT_FROM_EMAIL) van entre comillas
# simples, por ejemplo:  COMPANY_HOURS='Lunes a viernes, 9:00 a 18:00'
# (el archivo lo leen las tareas programadas con cron, que lo trata como un script de terminal).

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Si omites esta variable, el sitio arranca en modo producción (False). Para desarrollar en tu computador ponla en True
# (no la actives nunca en un servidor público: muestra errores detallados).
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
# Cuando el sitio ya tenga HTTPS (certificado), activar: redirección a https, cookies seguras y HSTS.
# DJANGO_HTTPS=True
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.cl
# Si usas Nginx (envía X-Forwarded-For), activar para que los límites de uso distingan a cada visitante:
# TRUST_PROXY_HEADERS=True

# Sin esta clave, el asistente deriva TODAS las consultas a ticket (modo seguro por defecto).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Base de datos: por defecto usa SQLite (no requiere nada más). Para MySQL/RDS, descomentar:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=nexoia
# DB_USER=admin
# DB_PASSWORD=
# DB_HOST=tu-endpoint-de-rds.amazonaws.com
# DB_PORT=3306

# --- Datos de la empresa (aparecen en la página de inicio y el asistente los usa para responder) ---
# Deja vacío lo que no quieras mostrar. WhatsApp: solo dígitos con código de país (ej. 56912345678).
COMPANY_PHONE=
COMPANY_WHATSAPP=
COMPANY_EMAIL=
COMPANY_HOURS=
COMPANY_AREA=
COMPANY_ADDRESS=

# --- Correo (notificaciones por email a clientes, moderadores y administradores) ---
# Por defecto los correos se imprimen en la terminal (modo prueba). Para enviarlos de verdad:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=clave-de-aplicacion
# DEFAULT_FROM_EMAIL=Soluciones SSDP <tu-correo@gmail.com>
# Dirección pública del sitio, para los enlaces dentro de los correos:
SITE_URL=http://127.0.0.1:8000

# --- Límites de uso (valores por defecto) ---
# CHAT_MAX_PER_HOUR=30              mensajes por cliente y hora (protege el gasto de la IA)
# VISITOR_CHAT_MAX_PER_10MIN=40     mensajes del chat sin cuenta por visitante
# LOGIN_MAX_ATTEMPTS=5              intentos fallidos de contraseña antes de bloquear
# LOGIN_LOCK_MINUTES=15
# STALE_TICKET_HOURS=24             horas sin asignar para marcar un ticket como "sin atender"
# EMAIL_ASYNC=True                  enviar correos en segundo plano

# --- Seguridad adicional ---
# Obliga a moderadores y administradores a activar la verificación en dos pasos. Recomendado en producción: cada uno
# configura su aplicación autenticadora la primera vez que entra, y quien aún no lo hace solo ve esa pantalla.
REQUIRE_2FA_STAFF=True
# REGISTER_MIN_SECONDS=3            un formulario de registro enviado más rápido se considera un bot
# REGISTER_MAX_PER_HOUR=5           cuentas nuevas por dirección y hora
# TURNSTILE_SITE_KEY=               CAPTCHA opcional de Cloudflare Turnstile (gratis): clave pública
# TURNSTILE_SECRET_KEY=             y clave secreta

# --- Datos y retención ---
# CHAT_RETENTION_DAYS=180           los chats se borran pasados estos días (comando purge_old_data)
# NOTIFICATION_RETENTION_DAYS=90    notificaciones leídas
# AI_ASSIST_MAX_PER_HOUR=20         sugerencias de IA para moderadores, por usuario y hora

# --- Monitoreo ---
# ENVIRONMENT_LABEL=pruebas         muestra un aviso rojo "Ambiente de pruebas" (para un sitio de ensayo, no el real)
# DJANGO_ADMIN_EMAILS=tu@correo.cl  recibe por correo el detalle de cada error grave del sitio (separar con comas)
